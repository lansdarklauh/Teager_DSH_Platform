{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=DshPlatform;User ID=sa;Password=ChangeMe_123;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Dsh": {
    "Storage": {
      "DataDir": "./.data",
      "LogDir": "./.logs",
      "CacheDir": "./.cache"
    },
    "Platform": {
      "MaxPoolDepth": 5,
      "SessionHours": 168,
      "CookieSecure": "auto",
      "ArchiveRetentionDays": 30,
      "AuditRetentionDays": 365,
      "MaxUploadMb": 200,
      "CorsOrigins": [],
      "AutoMigrate": true
    },
    "Runtime": {
      "DefaultProvider": "DeepSeekHarness",
      "DshExecutable": "dsh",
      "IdleMinutes": 5,
      "AutoStopMinutes": 60,
      "MaxConcurrentRunsPerPool": 4,
      "RunTimeoutMinutes": 30,
      "TerminalEnabled": true,
      "SynchronizePersonalPoolProvider": true
    },
    "Sandbox": {
      "Enabled": true,
      "Image": "teager-dsh-sandbox:usage-only"
    },
    "Security": {
      "MasterKey": "CHANGE_ME_DSH_MASTER_KEY_CHANGE_ME"
    },
    "Seed": {
      "OrganizationName": "默认组织",
      "AdminUsername": "admin",
      "DemoData": false
    },
    "RateLimit": {
      "PermitPerMinute": 1200,
      "LoginPerMinute": 10
    },
    "Policy": {
      "AllowNetwork": true,
      "AllowTerminal": true,
      "SandboxMode": "workspace-write",
      "MaxWorkspaces": 100,
      "MaxStorageMbPerWorkspace": 5120,
      "MaxConcurrentRuns": 4,
      "MaxMessagesPerDay": 0,
      "MaxTokensPerDay": 0,
      "MaxRunMinutes": 30
    }
  }
}
