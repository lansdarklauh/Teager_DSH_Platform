# ============================================================================
# DSH 平台环境变量示例（复制为 .env 使用；.env 已被 .gitignore 忽略，切勿提交）
# 同一批变量适用于：deploy/docker-compose.yml、backend/docker-compose.yml，以及 Teager_DevOps 部署表单的“环境变量”。
# 带“必填”的必须修改；其余有默认值。
# ============================================================================

# ── 必填：安全 ────────────────────────────────────────────────────────────
# 用于 AES-GCM 加密存储 Secret 的主密钥：任意长随机字符串（如 openssl rand -base64 48）。
# 丢失或更换后，已保存的密钥（Secret）将无法解密，请妥善备份。
DSH_MASTER_KEY=

# 首个平台管理员（仅当数据库中没有管理员时创建）。建好后可清空密码变量。
# 密码至少 8 位，须同时包含字母与数字。
DSH_ADMIN_USERNAME=admin
DSH_ADMIN_PASSWORD=

# ── 必填：数据库（SQL Server 2017+） ─────────────────────────────────────
# 使用 deploy/docker-compose.yml 的 with-db 自带库时，只需设置 MSSQL_SA_PASSWORD，DSH_SQL 可留空。
MSSQL_SA_PASSWORD=
# 外部 SQL Server：宿主机上的库用 host.docker.internal；其他机器改成该机地址。程序启动时自动迁移建表（DSH_AUTO_MIGRATE=true）。
# DSH_SQL=Server=host.docker.internal,1433;Database=DshPlatform;User ID=sa;Password=你的密码;TrustServerCertificate=True;MultipleActiveResultSets=true
DSH_AUTO_MIGRATE=true

# ── 目录与卷挂载（宿主机路径；三类目录相互独立，可放不同磁盘）───────────────
# 数据：Workspace 文件 / 共享空间 / 各 Pool 的 DSH_HOME / 快照 —— 必须持久化并纳入备份
DSH_DATA_DIR=/var/lib/dsh/data
# 日志：应用日志（按天滚动，保留 14 天）+ Agent 运行事件日志（JSONL，不入库）
DSH_LOG_DIR=/var/log/dsh
# 缓存：上传 / 打包临时文件、dsh 的 HOME，可随时清空
DSH_CACHE_DIR=/var/cache/dsh
# Nginx（前端）日志与缓存
DSH_NGINX_LOG_DIR=/var/log/dsh/nginx
DSH_NGINX_CACHE_DIR=/var/cache/dsh/nginx
# 自带 SQL Server 的数据文件目录（需对 uid 10001 可写）
DSH_MSSQL_DIR=/var/lib/dsh/mssql

# ── 访问与端口 ─────────────────────────────────────────────────────────
DSH_WEB_PORT=5680
DSH_API_PORT=5600
# 对外访问基址（展示在 SDK 示例里；留空则取浏览器当前地址），如 https://dsh.company.com
DSH_PUBLIC_URL=
# Cookie Secure：auto（按 HTTPS / X-Forwarded-Proto 自动）/ true / false。生产请在前面加 HTTPS 反代。
DSH_COOKIE_SECURE=auto
DSH_NETWORK=dsh
TZ=Asia/Shanghai

# ── Runtime（DSH）──────────────────────────────────────────────────────
# 新建 Pool 的默认 Runtime Provider：DeepSeekHarness（真实 dsh）/ Mock（模拟，仅用于演示联调）
DSH_DEFAULT_PROVIDER=DeepSeekHarness
# 平台级默认模型密钥（可选，优先级最低；更推荐在 Web 里按 Pool / Workspace 配置密钥）
DEEPSEEK_API_KEY=
# 构建镜像时 npm 源与 dsh 版本（国内构建机可保持默认）
NPM_REGISTRY=https://registry.npmmirror.com
DSH_VERSION=latest
# Workspace 终端等同于容器内 shell，默认关闭；开启前请阅读 docs/deploy.md 的安全提示
DSH_TERMINAL_ENABLED=false
DSH_RUN_TIMEOUT_MINUTES=30
DSH_MAX_CONCURRENT_RUNS=4
DSH_RUNTIME_IDLE_MINUTES=5
DSH_RUNTIME_AUTOSTOP_MINUTES=60

# ── 平台默认策略（Pool 策略只能在此基础上收紧）───────────────────────────────
# read-only / workspace-write / danger-full-access
DSH_SANDBOX_MODE=workspace-write
DSH_MAX_WORKSPACE_MB=5120
DSH_MAX_UPLOAD_MB=200
DSH_MAX_BODY_SIZE=512m
DSH_RATE_LIMIT_PER_MINUTE=1200
DSH_LOGIN_PER_MINUTE=10

# ── 其他 ────────────────────────────────────────────────────────────────
DSH_LOG_LEVEL=Information
# 仅体验 / 验收：写入“集团 / 编辑部 / 市场部”演示数据与用户 a~e（密码 Demo@1234）。生产务必保持 false。
DSH_DEMO_DATA=false
