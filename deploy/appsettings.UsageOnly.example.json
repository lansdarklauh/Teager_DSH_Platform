{
  "Dsh": {
    "Runtime": { "TerminalEnabled": true, "DefaultProvider": "DeepSeekHarness", "SynchronizePersonalPoolProvider": true },
    "Sandbox": {
      "Enabled": true,
      "Image": "teager-dsh-sandbox:usage-only",
      "DockerExecutable": "docker",
      "PreviewBaseUrl": "https://{execution}.preview.example.net/",
      "NetworkAllowedHosts": [],
      "ModelFakeIpHosts": [],
      "MemoryMb": 512,
      "Cpus": 1,
      "MaxProcesses": 128,
      "MaxExecutions": 4,
      "MaxFiles": 50000,
      "MaxStorageMb": 5120,
      "MaxMinutes": 60,
      "ModelBudgetCredits": 0
    },
    "Platform": {
      "CookieSecure": "true",
      "PublicBaseUrl": "https://platform.example.net",
      "TrustedProxies": ["127.0.0.1"]
    },
    "Policy": { "AllowTerminal": true, "AllowNetwork": true, "SandboxMode": "workspace-write" }
  }
}
