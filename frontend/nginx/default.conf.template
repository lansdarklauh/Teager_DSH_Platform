# 管理端静态资源 + /api 反代到 API（含 SSE 流式与 WebSocket 终端）
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 5680;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;
    client_body_temp_path /var/cache/nginx/client_temp;
    proxy_temp_path /var/cache/nginx/proxy_temp;
    client_max_body_size ${MAX_BODY_SIZE};

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location = /healthz { access_log off; return 200 'ok'; add_header Content-Type text/plain; }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        # 保留浏览器访问的 Host:端口，后端据此校验 WebSocket Origin
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # SSE 流式事件与长任务：关闭缓冲、放宽超时
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_request_buffering off;
    }

    location /health/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $http_host;
    }

    # 带哈希的静态资源长缓存；入口 HTML 不缓存
    location /assets/ { expires 30d; add_header Cache-Control "public, immutable"; try_files $uri =404; }
    location = /index.html { add_header Cache-Control "no-store"; }
    location / { try_files $uri $uri/ /index.html; }
}
